@SecurityProject_HostAddress = http://localhost:5137

### REGISTER USER
POST {{SecurityProject_HostAddress}}/users/register 
Content-Type: application/json 

{
    "firstName": "",
    "lastName": "",
    "password": "",
    "email": ""
}

### LOGIN USER
POST {{SecurityProject_HostAddress}}/users/login
Content-Type: application/json 

{
    "email": "",
    "password": ""
}

### USER PROFILE
GET {{SecurityProject_HostAddress}}/users/profile
Content-Type: application/json 
Authorization: Bearer {token}

### FETCH ALL POSTS
GET {{SecurityProject_HostAddress}}/posts 
Content-Type: application/json

### CREATE POST
POST {{SecurityProject_HostAddress}}/posts 
Content-Type: application/json 
Authorization: Bearer {token}

{
    "title": "",
    "excerpt": "",
    "body": ""
}

### UPDATE POST
PUT {{SecurityProject_HostAddress}}/posts/{id}
Content-Type: application/json 
Authorization: Bearer {token}

{
    "title": "",
    "excerpt": "",
    "body": ""
}

### DELETE POST
DELETE {{SecurityProject_HostAddress}}/posts/{id}
Authorization: Bearer {token}


### GET ONE POST
GET {{SecurityProject_HostAddress}}/posts/{id}

### DELETE POST
DELETE {{SecurityProject_HostAddress}}/posts/{id}
Authorization: Bearer {token}
